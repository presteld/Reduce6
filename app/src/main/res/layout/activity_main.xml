<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF8A80"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/etZaehler"
        android:layout_width="259dp"
        android:layout_height="62dp"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#CCFF90"
        android:ems="10"
        android:gravity="center"
        android:hint="bitte Zähler eingeben"
        android:inputType="numberSigned"
        android:text="25"
        android:textColor="#8C9EFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="263dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="------------------------"
        android:textColor="#A7FFEB"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNenner"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#CCFF90"
        android:ems="10"
        android:gravity="center"
        android:hint="bitte Nenner eingeben"
        android:inputType="number"
        android:text="15"
        android:textColor="#8C9EFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnReduce"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="#B9F6CA"
        android:hint="kürzt den Bruch"
        android:text="Kürze"
        android:textColor="#8C9EFF"
        android:textSize="34sp"
        android:textStyle="bold" />

</LinearLayout>